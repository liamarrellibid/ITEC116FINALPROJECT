    {
      "name": "6. Security and validation examples",
      "item": [
        {
          "name": "Expected 422 - withdrawal exceeds funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"transactionType\": \"Withdrawal\",\n  \"amount\": 999999999,\n  \"description\": \"Intentional validation demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Expected 403 - customer reads a different customer account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{recipientAccountId}}"
          }
        },
        {
          "name": "Expected 401 - protected request without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Expected 400 - account balance cannot be patched",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"balance\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Expected 409 - duplicate registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sample Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete account type (Admin; expected 409 when used)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/account-types/{{accountTypeId}}"
          }
        },
        {
          "name": "Expected 401 - replay old refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{oldRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Expected 403 - customer cannot create an account type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/account-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"typeName\": \"Blocked {{$timestamp}}\",\n  \"minimumBalance\": \"0.00\",\n  \"interestRate\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Expected 422 - withdrawal breaks account minimum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{newAccountId}}\",\n  \"transactionType\": \"Withdrawal\",\n  \"amount\": \"200.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
